# Kopieren nach .env und mit echten Werten befüllen.
# .env NIEMALS committen (siehe .gitignore).

# --- Google Ads ---------------------------------------------------------
# Developer-Token: https://ads.google.com/aw/apicenter (Konto braucht
# mind. "Basic Access", um mit einem Live-Konto zu arbeiten).
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth2-Client aus der Google Cloud Console (Desktop- oder Web-App).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Refresh-Token, einmalig über den OAuth2-Flow der google-ads-Bibliothek
# erzeugt (siehe https://developers.google.com/google-ads/api/docs/oauth/cloud-project).
GOOGLE_ADS_REFRESH_TOKEN=

# Kunden-ID des MCC/Login-Kontos (ohne Bindestriche).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Kunden-ID des Ziel-Werbekontos, in dem Nata-Kampagnen laufen (ohne Bindestriche).
GOOGLE_ADS_CUSTOMER_ID=

# --- Meta Ads (Facebook/Instagram) --------------------------------------
# App aus https://developers.facebook.com/apps mit Marketing-API-Produkt.
META_APP_ID=
META_APP_SECRET=

# System-User- oder langlebiges User-Access-Token mit ads_management-Scope.
META_ACCESS_TOKEN=

# Werbekonto-ID, mit oder ohne "act_"-Präfix (beides wird akzeptiert).
META_AD_ACCOUNT_ID=
