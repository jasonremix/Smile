rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Medien liegen unter <typ>/<uid-des-hochladenden-nutzers>/<dateiname>.
    // Schreiben/Loeschen ist auf den eigenen Ordner beschraenzt, damit niemand
    // die Datei eines anderen Nutzers ueberschreiben oder loeschen kann.
    // Lesen bleibt fuer alle eingeloggten Nutzer offen (Empfaenger eines Snaps
    // ist nicht der Uploader) - der eigentliche Zugriffsschutz "wer darf einen
    // Snap ueberhaupt sehen" laeuft ueber die Firestore-Regeln auf das
    // zugehoerige snaps/-Dokument, das die Storage-URL enthaelt.
    match /snaps/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /stories/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Alles ausserhalb der beiden Pfade oben ist gesperrt.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
