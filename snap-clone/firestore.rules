rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Gruender-Sonderzugriff fuer die Ticket-Bearbeitung (Annehmen/Ablehnen/
    // Antworten, Sperren manuell aufheben) - bewusst als feste UID statt
    // eines Lookups auf "username == jasonbuerger": ein Lookup waere ein
    // zusaetzlicher, in Regeln fehleranfaelliger Read, und der Benutzername
    // koennte sich theoretisch aendern. Diese UID gehoert zum echten
    // "jasonbuerger"-Konto (Gruender-Account), keine Rolle/Custom-Claim
    // noetig, da es nur eine einzige Person mit diesem Zugriff gibt.
    function isFounder() {
      return isSignedIn() && request.auth.uid == 'O4xRu9e0qFRfnzsmgKWLNjE6r9U2';
    }

    // true, wenn der anfragende Nutzer mit ownerId befreundet ist (Freunde
    // werden beim Annehmen einer Anfrage auf beiden Seiten gespeichert,
    // ein Blick auf die Seite des Owners reicht daher aus).
    function isFriendOf(ownerId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(ownerId)/friends/$(request.auth.uid));
    }

    // Automatische Sperr-/Timeout-Durchsetzung (siehe moderationService.js
    // fuer die Strike-Vergabe): unabhaengig davon, ob der Client brav
    // mitspielt, kann eine bereits gesetzte Sperre serverseitig nicht
    // umgangen werden - jeder Versuch, waehrend einer aktiven Sperre neuen
    // Inhalt zu erstellen, wird hier unabhaengig vom Inhalt selbst abgelehnt.
    function isCurrentlyRestricted(uid) {
      let restrictedUntil = get(/databases/$(database)/documents/users/$(uid)).data.get('restrictedUntil', null);
      return restrictedUntil != null && restrictedUntil > request.time;
    }

    // Serverseitige Haelfte der automatischen Inhaltspruefung (siehe
    // src/utils/contentFilter.js fuer die clientseitige Vorab-Pruefung mit
    // Leetspeak-Normalisierung und URL-/Kontakt-Heuristiken - das laesst
    // sich in der begrenzten Firestore-Regelsprache nicht 1:1 nachbauen).
    // Diese Funktion deckt die Kernliste an Begriffen/Phrasen ab und greift
    // unabhaengig vom Client, also auch bei direkten Schreibversuchen gegen
    // Firestore. Bewusst dieselbe Wortliste wie im Client, damit beide
    // Ebenen konsistent bleiben.
    function containsBlockedTerm(text) {
      return text is string
        && text.lower().matches(
          '.*(hurensohn|wichser|wixxer|arschloch|missgeburt|untermensch|abschaum|fotze'
          + '|schlampe|hure|bastard|wixer|hackfresse|spacko|vollidiot|penner'
          + '|spast|spasti|mongo|kanake|kameltreiber|judensau|zigeuner'
          + '|schwuchtel|kampflesbe|tunte'
          + '|nigger|nigga|faggot|retard|chink|kike|spic|tranny|whore|slut|bitch|cunt'
          + '|schick mir nacktbilder|zeig mir deine titten|schick nudes|nacktfoto von dir'
          + '|ich bringe dich um|ich toete dich|ich töte dich|ich tote dich'
          + '|ich schlage dich|ich steche dich|ich erstech dich|du wirst sterben|du bist tot'
          + '|ich mach dich fertig|ich finde dich und'
          + '|ich weiss wo du wohnst|ich weiß wo du wohnst|ich vergewaltige dich'
          + '|bring dich um|ritz dich|du solltest dich umbringen|du solltest sterben'
          + '|ich will nicht mehr leben|ich will sterben|ich bring mich um|ich bringe mich um'
          + '|ich toete mich|ich töte mich|ich mache schluss mit allem'
          + '|ich will mir das leben nehmen|suizid begehen|selbstmord begehen'
          + '|ich ritze mich|ich schneide mich|keinen grund mehr weiterzuleben'
          + '|klick hier|jetzt klicken|gratis geld|schnell reich werden'
          + '|geld verdienen von zuhause|jetzt kaufen|bitcoin investment|krypto investment'
          + '|kostenlos abstauben|nur heute kostenlos|folge mir für follower'
          + '|gewinnspiel teilnehmen jetzt|kostenloses iphone'
          + '|verifiziere dein konto hier|dein konto wird gesperrt|bestätige deine daten hier'
          + '|dein paket konnte nicht zugestellt werden).*'
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      // "verified" darf beim Erstellen des eigenen Profils nie mitgeschickt
      // werden - sonst koennte sich jede Person durch einen manipulierten
      // Signup-Request selbst den Verifizierungs-Haken geben. Der Status
      // wird ausschliesslich per Admin-Zugriff (auszerhalb der Client-Regeln)
      // gesetzt.
      allow create: if isOwner(userId)
        && !('verified' in request.resource.data)
        && request.resource.data.uid == userId
        && request.resource.data.nataScore == 0
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40
        && !containsBlockedTerm(request.resource.data.displayName);

      // Manipulationsschutz auf Basis reiner Firestore-Regeln hat Grenzen:
      // nataScore darf sich pro Schreibvorgang nur um einen kleinen,
      // plausiblen Betrag aendern statt auf beliebige Werte gesetzt zu
      // werden. Obergrenze +20 pro Schreibvorgang - muss zu
      // MAX_SCORE_PER_ACTION in userService.js passen (hoechste einzelne
      // Aktion: Beitrag +6, Snap-Fanout gedeckelt auf +20). Wirklich
      // serverseitig garantiert faelschungssicher wird der Score erst mit
      // einer Cloud Function statt Client-Schreibzugriff (siehe Roadmap).
      // Gruender-Ausnahme als eigener, schmaler Zweig statt in die
      // Owner-gebundenen Klauseln unten verwoben: der Gruender ist bei
      // fremden Konten nie isOwner(userId), darf aber gezielt NUR
      // restrictedUntil anfassen (Sperre nach Ticket-Pruefung manuell
      // aufheben) - sonst nichts an einem fremden Profil.
      allow update: if (
          isFounder()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['restrictedUntil', 'verified'])
          && (
            !('restrictedUntil' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.restrictedUntil == null
            || request.resource.data.restrictedUntil is timestamp
          )
          && (
            !('verified' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.verified is bool
          )
        ) || (
        isOwner(userId)
        // "verified" ist auch beim Update fest gesperrt - nur Admin-Zugriff
        // (Service Account, ausserhalb der Client-Regeln) darf es setzen.
        && !('verified' in request.resource.data.diff(resource.data).affectedKeys())
        // verifiedSeen darf die eigene Person nur auf true setzen (einmalige
        // Glueckwunsch-Anzeige quittieren), nie zurueck auf false.
        && (
          !('verifiedSeen' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.verifiedSeen == true
        )
        && (
          !('nataScore' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.nataScore >= resource.data.nataScore
              && request.resource.data.nataScore <= resource.data.nataScore + 20)
        )
        && (
          !('username' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.username is string
              && request.resource.data.username.size() >= 3
              && request.resource.data.username.size() <= 20)
        )
        && (
          !('displayName' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.displayName is string
              && request.resource.data.displayName.size() >= 1
              && request.resource.data.displayName.size() <= 40
              && !containsBlockedTerm(request.resource.data.displayName))
        )
        // betaTesterNumber/referredBy werden einmalig direkt nach der
        // Registrierung gesetzt und danach nie wieder geaendert.
        && (
          !('betaTesterNumber' in request.resource.data.diff(resource.data).affectedKeys())
          || (!('betaTesterNumber' in resource.data) && request.resource.data.betaTesterNumber is int)
        )
        && (
          !('referredBy' in request.resource.data.diff(resource.data).affectedKeys())
          || (!('referredBy' in resource.data) && request.resource.data.referredBy is string)
        )
        && (
          !('referralCount' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.referralCount is int
              && request.resource.data.referralCount >= 0
              && request.resource.data.referralCount <= resource.data.get('referralCount', 0) + 1)
        )
        // "Was ist gerade los" - reiner Text-Status, kein Standort-Feld.
        // Nur kurze Texte, kein beliebiger Payload.
        && (
          !('status' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.status == null
          || (request.resource.data.status.text is string
              && request.resource.data.status.text.size() > 0
              && request.resource.data.status.text.size() <= 60
              && !containsBlockedTerm(request.resource.data.status.text))
        )
        && (
          !('bio' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.bio == null
          || (request.resource.data.bio is string
              && request.resource.data.bio.size() <= 150
              && !containsBlockedTerm(request.resource.data.bio))
        )
        && (
          !('avatarColor' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.avatarColor is string
              && request.resource.data.avatarColor.size() <= 9)
        )
        // Standort ist explizites Opt-in (siehe ProfileEditScreen) und wird
        // nur grob als Stadtname gespeichert, nie als exakte Koordinaten -
        // deshalb "city" statt lat/lng.
        && (
          !('location' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.location == null
          || (request.resource.data.location.city is string
              && request.resource.data.location.city.size() > 0
              && request.resource.data.location.city.size() <= 60)
        )
        // Sichtbarkeitseinstellungen (siehe PrivacyScreen): "discoverable"
        // blendet die eigene Person aus Suche/Vorschlaegen aus (das Profil
        // selbst bleibt fuer alle Signed-in-Nutzer lesbar - siehe oben),
        // "connectionsVisibility" steuert, wer die eigene Connections-Liste
        // sehen darf (siehe friends-Subcollection-Regel unten).
        && (
          !('discoverable' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.discoverable is bool
        )
        && (
          !('connectionsVisibility' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.connectionsVisibility in ['everyone', 'onlyMe']
        )
        // Automatische Sperr-/Timeout-Eskalation (siehe recordStrike() in
        // moderationService.js): strikeWeight darf nur steigen, nie sinken,
        // und pro Schreibvorgang nur um einen plausiblen Betrag (hoechstes
        // Einzelgewicht ist "threat" mit 8, +10 Sicherheitsspanne).
        // restrictedUntil darf ebenfalls nur nach vorne verschoben, nie
        // verkuerzt oder geloescht werden - so kann sich niemand selbst
        // entsperren, selbst mit einer manipulierten App.
        && (
          !('strikeWeight' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.strikeWeight is int
              && request.resource.data.strikeWeight >= resource.data.get('strikeWeight', 0)
              && request.resource.data.strikeWeight <= resource.data.get('strikeWeight', 0) + 10)
        )
        // restrictedUntil darf die betroffene Person selbst (auch mit
        // manipulierter App) nur nach vorne verschieben, nie verkuerzen
        // oder loeschen - die einzige Ausnahme ist der separate
        // Gruender-Zweig oben.
        && (
          !('restrictedUntil' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.restrictedUntil is timestamp
              && request.resource.data.restrictedUntil >= resource.data.get('restrictedUntil', request.time))
        )
      );

      allow delete: if isOwner(userId);

      // Eigene Freunde duerfen die Freundesliste mitlesen (nicht nur der
      // Owner selbst) - noetig fuer "gemeinsame Freunde" und "Freunde von
      // Freunden entdecken". Bewusster, ueblicher Kompromiss, kein oeffentlicher
      // Zugriff: nur wer bereits verifiziert befreundet ist, sieht mit.
      match /friends/{friendId} {
        // "connectionsVisibility" == 'onlyMe' auf dem Owner-Profil schaltet
        // den isFriendOf-Ausnahmefall ab (Standard weiterhin: Freunde von
        // Freunden duerfen mitlesen, siehe isFriendOf oben).
        allow read: if isOwner(userId)
          || (
            isFriendOf(userId)
            && get(/databases/$(database)/documents/users/$(userId)).data.get('connectionsVisibility', 'everyone') != 'onlyMe'
          );
        allow write: if isSignedIn() && (isOwner(userId) || request.auth.uid == friendId);
      }

      // Nachvollziehbare Score-Historie fuer die Home-/Score-Ansicht - reine
      // Anzeige-Hilfe, kein Sicherheitsmechanismus (der eigentliche Schutz
      // vor Score-Manipulation liegt auf dem nataScore-Feld selbst weiter
      // oben). Nur create/read durch die eigene Person, unveraenderlich
      // danach, damit die Historie nicht nachtraeglich "geschoent" wird.
      match /scoreEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 5
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 60;
        allow update, delete: if false;
      }

      // Wer blockiert wurde, steht hier - nur der blockierende Nutzer selbst
      // darf seine eigene Liste sehen/aendern.
      match /blocked/{blockedUid} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && blockedUid != userId;
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      // Gemerkte Beitraege - rein privat, nur die eigene Person sieht/aendert
      // ihre eigene Liste.
      match /savedPosts/{postId} {
        allow read, create, delete: if isOwner(userId);
        allow update: if false;
      }

      match /stories/{storyId} {
        // Eigene Storys immer sichtbar; sonst nur laut gewaehlter Sichtbarkeit:
        // "friends" braucht eine bestehende Freundschaft, "custom" braucht
        // einen Eintrag in visibleTo.
        allow read: if isOwner(userId)
          || (resource.data.visibility == 'friends' && isFriendOf(userId))
          || (resource.data.visibility == 'custom' && request.auth.uid in resource.data.visibleTo);
        allow create: if isOwner(userId)
          && request.resource.data.ownerId == userId
          && request.resource.data.mediaUrl is string
          && request.resource.data.visibility in ['friends', 'custom']
          && (request.resource.data.visibility != 'custom' || request.resource.data.visibleTo is list)
          && (
            !('filter' in request.resource.data)
            || request.resource.data.filter in ['none', 'warm', 'cool', 'sunset', 'night', 'retro']
          );
        // Erlaubt anderen Nutzern, sich als "viewer" einzutragen - dabei darf
        // sich ausschliesslich das viewers-Feld aendern.
        allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers']);
        allow delete: if isOwner(userId);
      }

      // In-App-Benachrichtigungen: die aktive Person schreibt direkt in die
      // notifications-Subcollection der Zielperson (kein Server/Cloud
      // Function vorhanden). Deshalb streng auf eine feste Feldliste und
      // erlaubte Typen begrenzt, damit niemand beliebige Inhalte in fremde
      // Postfaecher schreiben kann. Gelesen/verwaltet wird ausschliesslich
      // vom Empfaenger selbst; "read" darf er danach nur noch auf true
      // setzen (quittieren), sonst nichts am Eintrag aendern.
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(userId);
        allow create: if isSignedIn()
          && request.auth.uid == request.resource.data.fromUid
          && request.resource.data.fromUid != userId
          && request.resource.data.type in ['like', 'comment', 'friend_request', 'friend_accept']
          && request.resource.data.fromDisplayName is string
          && request.resource.data.fromDisplayName.size() <= 40
          && request.resource.data.read == false
          && request.resource.data.keys().hasOnly([
            'type', 'fromUid', 'fromDisplayName', 'fromUsername', 'fromAvatarColor',
            'postId', 'preview', 'read', 'createdAt'
          ]);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
      }

      // Unveraenderliches Protokoll der eigenen Verstoesse gegen die
      // Inhaltspruefung (siehe recordStrike() in moderationService.js) -
      // nur create, nie update/delete, damit es nicht nachtraeglich
      // "bereinigt" werden kann. Gewicht ist an die Kategorie gekoppelt,
      // damit niemand ein falsches (zu niedriges) Gewicht vortaeuscht.
      match /moderationStrikes/{strikeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && (
            (request.resource.data.category == 'spam' && request.resource.data.weight == 1)
            || (request.resource.data.category == 'language' && request.resource.data.weight == 3)
            || (request.resource.data.category == 'threat' && request.resource.data.weight == 8)
          );
        allow update, delete: if false;
      }
    }

    // Gemeinsamer Zaehler fuer die fortlaufende Beta-Tester-Nummer. Ohne
    // Cloud Function nicht perfekt faelschungssicher (rein kosmetischer Wert,
    // kein Sicherheitsmerkmal), deshalb wie an anderen Stellen auf einen
    // plausiblen Sprung von maximal +1 pro Schreibvorgang begrenzt.
    match /meta/counters {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.betaTesterCount == 1;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['betaTesterCount'])
        && request.resource.data.betaTesterCount == resource.data.betaTesterCount + 1;
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.from
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && request.auth.uid == resource.data.to
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if false;
    }

    match /snaps/{snapId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId);
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.recipientId is string
        && request.resource.data.mediaUrl is string
        && request.resource.data.viewDuration >= 1
        && request.resource.data.viewDuration <= 10
        && (
          !('filter' in request.resource.data)
          || request.resource.data.filter in ['none', 'warm', 'cool', 'sunset', 'night', 'retro']
        )
        && isFriendOf(request.resource.data.recipientId);
      // replayUsed darf nur von der empfangenden Person und nur einmal von
      // false/undefined auf true gesetzt werden - nie zurueck, damit das
      // "einmal erneut ansehen" wirklich nur einmal moeglich ist.
      allow update: if isSignedIn() && request.auth.uid == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewed', 'viewedAt', 'replayUsed'])
        && (
          !('replayUsed' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.replayUsed == true
        );
      allow delete: if isSignedIn() &&
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId);
    }

    match /chats/{chatId} {
      allow read, delete: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      // streakCount/streakLastDate/streakSentToday werden clientseitig beim
      // Snap-Versand geschrieben (siehe recordStreakSnap) - ohne Cloud
      // Function serverseitig nicht faelschungssicher, deshalb wie bei
      // nataScore auf einen plausiblen Sprung von maximal +1 pro Schreibvorgang
      // begrenzt.
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastSenderId', 'updatedAt', 'participantNames',
                       'streakCount', 'streakLastDate', 'streakSentToday', 'typing', 'lastReadAt'])
        && (
          !('streakCount' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.streakCount is int
              && request.resource.data.streakCount >= 0
              && request.resource.data.streakCount <= resource.data.get('streakCount', 0) + 1)
        );

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Eine Nachricht ist entweder Text ODER Sprachnachricht (Beta) -
        // nie beides gleichzeitig. voiceDurationMs auf 2 Minuten gedeckelt.
        allow create: if isSignedIn()
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && !isCurrentlyRestricted(request.auth.uid)
          && (
            (request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000
              && !containsBlockedTerm(request.resource.data.text)
              && !('voiceUrl' in request.resource.data))
            || (request.resource.data.voiceUrl is string
              && request.resource.data.voiceDurationMs is int
              && request.resource.data.voiceDurationMs > 0
              && request.resource.data.voiceDurationMs <= 120000
              && !('text' in request.resource.data))
          );
        // Nur die sendende Person darf ihre eigene Nachricht bearbeiten -
        // ausschliesslich Text + "edited"-Markierung, sonst nichts.
        allow update: if isSignedIn() && request.auth.uid == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && !containsBlockedTerm(request.resource.data.text)
          && request.resource.data.edited == true;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;

        // Reaktionen als eigene Subcollection (Dokument-ID = Nutzer-uid),
        // analog zu posts/likes - jede Person kann nur ihren eigenen
        // Reaktions-Eintrag anlegen/loeschen.
        match /reactions/{uid} {
          allow read: if isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
          allow create, delete: if isOwner(uid) &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
          allow update: if false;
        }
      }
    }

    match /groups/{groupId} {
      allow read, delete: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50
        && !containsBlockedTerm(request.resource.data.name);
      // Jedes Mitglied darf umbenennen, selbst austreten oder neue Mitglieder
      // hinzufuegen (einfaches Modell ohne Admin-Rolle fuer die erste Version).
      allow update: if isSignedIn() && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastSenderId', 'updatedAt', 'memberIds', 'memberNames', 'name'])
        && (
          !('name' in request.resource.data.diff(resource.data).affectedKeys())
          || !containsBlockedTerm(request.resource.data.name)
        );

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        // Eine Nachricht ist entweder Text ODER Sprachnachricht (Beta) -
        // nie beides gleichzeitig. voiceDurationMs auf 2 Minuten gedeckelt.
        allow create: if isSignedIn()
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          && !isCurrentlyRestricted(request.auth.uid)
          && (
            (request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000
              && !containsBlockedTerm(request.resource.data.text)
              && !('voiceUrl' in request.resource.data))
            || (request.resource.data.voiceUrl is string
              && request.resource.data.voiceDurationMs is int
              && request.resource.data.voiceDurationMs > 0
              && request.resource.data.voiceDurationMs <= 120000
              && !('text' in request.resource.data))
          );
        allow update: if isSignedIn() && request.auth.uid == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && !containsBlockedTerm(request.resource.data.text)
          && request.resource.data.edited == true;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;

        match /reactions/{uid} {
          allow read: if isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow create, delete: if isOwner(uid) &&
            request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow update: if false;
        }
      }
    }

    // Meldungen sind per create durch die meldende Person erreichbar -
    // Einsicht nur durch den Gruender (Ticket-Verwaltung/Meldungen-Screen),
    // Bearbeitung generell nie ueber die Client-App.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.reporterId
        && request.resource.data.reason in
             ['spam', 'harassment', 'threat', 'inappropriate_content', 'impersonation', 'other']
        && (
          !('description' in request.resource.data)
          || (request.resource.data.description is string
              && request.resource.data.description.size() <= 1000)
        )
        && (
          !('incidentTiming' in request.resource.data)
          || request.resource.data.incidentTiming == null
          || request.resource.data.incidentTiming in ['just_now', 'today', 'this_week', 'longer_ago']
        );
      allow read: if isFounder();
      allow update, delete: if false;
    }

    // Beta-Feedback: per create durch die absendende Person, Einsicht nur
    // durch den Gruender.
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read: if isFounder();
      allow update, delete: if false;
    }

    // Ankuendigungen des Gruenders an alle Nutzer:innen - bewusst EIN
    // gemeinsames Dokument-Set statt Fan-out in jede einzelne
    // notifications-Subcollection (kein zusaetzlicher Schreibaufwand pro
    // Nutzer:in, kein Skalierungsproblem). Jede Person liest dieselben
    // Dokumente; "gesehen" wird rein lokal auf dem Geraet gemerkt (siehe
    // FounderAnnouncementBanner.js, gleiches Prinzip wie
    // UpdateAnnouncementBanner.js) - es gibt also KEINE Push-/E-Mail-
    // Benachrichtigung, nur einen Banner beim naechsten App-Start.
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isFounder()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000;
      allow update: if false;
      allow delete: if isFounder();
    }

    // Support-Tickets: anders als Meldungen/Feedback darf die erstellende
    // Person ihre eigenen Tickets lesen (Verlauf im TicketsScreen) und in
    // engen Grenzen aendern - nur status ("bot_resolved" -> "escalated"
    // oder "closed") und escalatedToFounder (nur false -> true, nie
    // zurueck). Inhalt (category/subject/message/botResponse/uid) ist nach
    // dem Erstellen unveraenderlich, damit niemand nachtraeglich die
    // eigene Anfrage oder die geloggte Bot-Antwort umschreiben kann.
    match /tickets/{ticketId} {
      // Gruender sieht ALLE Tickets (fuer die Ticket-Verwaltung), normale
      // Nutzer nur ihre eigenen.
      allow read: if isOwner(resource.data.uid) || isFounder();
      allow create: if isOwner(request.resource.data.uid)
        && request.resource.data.category in
             ['restriction_appeal', 'content_decision', 'account_issue', 'other']
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.botResponse is string
        && request.resource.data.botResponse.size() > 0
        && request.resource.data.status == 'bot_resolved'
        && request.resource.data.escalatedToFounder == false;
      allow update: if (
          isOwner(resource.data.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'escalatedToFounder'])
          && request.resource.data.status in ['escalated', 'closed']
          && request.resource.data.escalatedToFounder is bool
          && (
            request.resource.data.escalatedToFounder == resource.data.escalatedToFounder
            || request.resource.data.escalatedToFounder == true
          )
        ) || (
          // Gruender-Bearbeitung: Annehmen/Ablehnen/Antworten. Aendert nie
          // die vom Nutzer eingereichten Felder (uid/category/subject/
          // message/botResponse/escalatedToFounder/createdAt) - nur die
          // eigene Antwort und den Bearbeitungsstatus.
          isFounder()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolution', 'founderResponse', 'founderResponseAt'])
          && request.resource.data.status in ['answered', 'closed']
          && request.resource.data.resolution in [null, 'accepted', 'rejected']
          && (
            !('founderResponse' in request.resource.data)
            || (request.resource.data.founderResponse is string
                && request.resource.data.founderResponse.size() <= 2000)
          )
          && request.resource.data.founderResponseAt is timestamp
        );
      allow delete: if false;
    }

    // Beitraege im Home-Feed. MVP-Entscheidung: Lesbar fuer alle
    // angemeldeten Nutzer (wie "Entdecken"/Profile), nicht nur Connections -
    // "Fuer dich" braucht eine gewisse Reichweite ueber die eigene
    // Connections-Liste hinaus. likeCount/commentCount sind ohne Cloud
    // Function nicht perfekt faelschungssicher, deshalb wie bei nataScore
    // auf einen plausiblen Sprung von maximal +-1 pro Schreibvorgang begrenzt.
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && !isCurrentlyRestricted(request.auth.uid)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && !containsBlockedTerm(request.resource.data.text)
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;
      allow update: if isSignedIn()
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
            && (request.resource.data.likeCount == resource.data.likeCount + 1
                || request.resource.data.likeCount == resource.data.likeCount - 1))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
            && request.resource.data.commentCount == resource.data.commentCount + 1)
        );
      allow delete: if isOwner(resource.data.authorId);

      // Existenz des Dokuments (id = Nutzer-uid) bedeutet "geliked" - kein
      // Inhalt noetig, deshalb reicht create/delete durch die liked Person.
      match /likes/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && !isCurrentlyRestricted(request.auth.uid)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && !containsBlockedTerm(request.resource.data.text);
        allow delete: if isOwner(resource.data.authorId);
        allow update: if false;
      }
    }
  }
}
